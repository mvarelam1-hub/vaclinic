# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================================================
# Etapa 2/3 (Aseguramiento de la Calidad / Seminario) — backend real.
# NINGUNO de estos valores va hardcodeado en el código: todos se leen de
# variables de entorno (ver server/db.ts, server/auth-firebase.ts, server/token.ts).
# ==========================================================================

# DATABASE_URL: cadena de conexión a PostgreSQL (Neon en producción, capa gratuita).
# Formato: postgres://usuario:password@host:5432/basededatos
DATABASE_URL="MY_POSTGRES_CONNECTION_STRING"

# PGSSLMODE: dejar SIN definir (o distinto de "disable") en producción — Neon exige TLS.
# Solo se pone en "disable" para un Postgres local de desarrollo sin TLS.
# PGSSLMODE="disable"

# FIREBASE_ADMIN_CREDENTIALS_JSON: contenido COMPLETO del JSON de la cuenta de
# servicio de Firebase Admin (Firebase Console > Configuración del proyecto >
# Cuentas de servicio > Generar nueva clave privada). Se usa para verificar los
# tokens de inicio de sesión del personal (Firebase Authentication) en el backend.
# NUNCA se sube este archivo ni su contenido al repositorio.
FIREBASE_ADMIN_CREDENTIALS_JSON="MY_FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON"

# PORTAL_TOKEN_SECRET: cadena larga y aleatoria (ej. `openssl rand -hex 32`)
# usada para firmar los tokens de sesión del Portal del Paciente.
PORTAL_TOKEN_SECRET="MY_LONG_RANDOM_SECRET"

# DEV_AUTH_BYPASS_UID: SOLO para pruebas locales sin credenciales reales de
# Firebase. El backend lo IGNORA por completo si NODE_ENV=production, sin
# importar qué se envíe. No definir en ningún entorno de producción o demo pública.
# DEV_AUTH_BYPASS_UID="uid-de-prueba"
